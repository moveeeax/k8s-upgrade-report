<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kubernetes upgrade readiness {{.Plan.Current}} &rarr; {{.Plan.Target}}</title>
<style>
  :root {
    --bg: #ffffff; --fg: #16191d; --muted: #5c6570; --line: #e3e6ea;
    --card: #f7f8fa; --blocker: #b3261e; --warn: #9a6700; --ok: #1a7f37; --accent: #0b57d0;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14171a; --fg: #e6e9ec; --muted: #9aa4ae; --line: #2a2f35;
      --card: #1b1f24; --blocker: #ff6b60; --warn: #e3b341; --ok: #4ac26b; --accent: #6ea8fe;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  main { max-width: 60rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
  h1 { font-size: 1.6rem; margin: 0 0 .25rem; letter-spacing: -.01em; }
  h2 { font-size: 1.05rem; margin: 2.5rem 0 .75rem; padding-bottom: .35rem; border-bottom: 1px solid var(--line); }
  .sub { color: var(--muted); font-size: .9rem; margin: 0 0 1.5rem; }
  code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .85em; }
  .verdict { border: 1px solid var(--line); border-left: 5px solid var(--muted);
    background: var(--card); border-radius: 6px; padding: 1rem 1.15rem; }
  .verdict.nogo { border-left-color: var(--blocker); }
  .verdict.patch { border-left-color: var(--warn); }
  .verdict.go { border-left-color: var(--ok); }
  .verdict .label { font-weight: 700; letter-spacing: .08em; font-size: .78rem; text-transform: uppercase; }
  .verdict.nogo .label { color: var(--blocker); }
  .verdict.patch .label { color: var(--warn); }
  .verdict.go .label { color: var(--ok); }
  .verdict ul { margin: .75rem 0 0; padding-left: 1.1rem; }
  .verdict li { margin: .3rem 0; }
  .counts { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.25rem 0 0; }
  .count { background: var(--card); border: 1px solid var(--line); border-radius: 6px;
    padding: .55rem .8rem; min-width: 7.5rem; }
  .count b { display: block; font-size: 1.35rem; line-height: 1.2; }
  .count span { color: var(--muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
  .finding { border: 1px solid var(--line); border-radius: 6px; padding: .85rem 1rem; margin: .6rem 0; background: var(--card); }
  .finding .head { display: flex; flex-wrap: wrap; gap: .5rem; align-items: baseline; }
  .finding .title { font-weight: 600; }
  .finding .where { color: var(--muted); font-size: .82rem; }
  .finding p { margin: .45rem 0 0; }
  .finding .fix { border-left: 3px solid var(--accent); padding-left: .7rem; }
  .tag { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em;
    border: 1px solid var(--line); border-radius: 3px; padding: .1rem .4rem; color: var(--muted); }
  .tag.auto { color: var(--ok); border-color: var(--ok); }
  .tag.owner { color: var(--warn); border-color: var(--warn); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .88rem; }
  th, td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
  ol.seq { padding-left: 1.2rem; }
  ol.seq li { margin: .35rem 0; }
  .empty { color: var(--muted); font-style: italic; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line);
    color: var(--muted); font-size: .8rem; }
  a { color: var(--accent); }
</style>
</head>
<body>
<main>
  <h1>Kubernetes upgrade readiness: {{.Plan.Current}} &rarr; {{.Plan.Target}}</h1>
  <p class="sub">
    {{if .Plan.ProviderName}}{{.Plan.ProviderName}} &middot; {{end}}
    source <span class="mono">{{.Source}}</span> &middot;
    generated {{.GeneratedAt}} by {{.Tool}} {{.Version}}
  </p>

  <div class="verdict {{.VerdictCSS}}">
    <div class="label">{{upper .Plan.Verdict.Decision}}</div>
    <p>{{.Plan.Verdict.Summary}}</p>
    {{if .Plan.Verdict.Blockers}}
    <ul>{{range .Plan.Verdict.Blockers}}<li>{{.}}</li>{{end}}</ul>
    {{end}}
  </div>

  <div class="counts">
    <div class="count"><b>{{.Summary.Blockers}}</b><span>blockers</span></div>
    <div class="count"><b>{{.Summary.Warnings}}</b><span>warnings</span></div>
    <div class="count"><b>{{.Summary.VendorOwned}}</b><span>vendor owned</span></div>
    <div class="count"><b>{{.Summary.Autofixable}}</b><span>auto fixable</span></div>
    <div class="count"><b>{{.Summary.Resources}}</b><span>objects scanned</span></div>
    <div class="count"><b>{{.Summary.Files}}</b><span>files scanned</span></div>
  </div>

  <h2>Blockers you own</h2>
  {{if .Blockers}}
    {{range .Blockers}}{{template "finding" .}}{{end}}
  {{else}}<p class="empty">None. Nothing you control stops the upgrade at {{.Plan.Target}}.</p>{{end}}

  <h2>Vendor must upgrade first</h2>
  {{if .Vendor}}
    <p class="sub">These objects are owned by a chart, an operator or a GitOps controller. Patching them in your repository is reverted on the next reconcile - the upstream has to ship the new API.</p>
    {{range .Vendor}}{{template "finding" .}}{{end}}
  {{else}}<p class="empty">No vendor-owned blockers found.</p>{{end}}

  <h2>Warnings after {{.Plan.Target}}</h2>
  {{if .Warnings}}
    {{range .Warnings}}{{template "finding" .}}{{end}}
  {{else}}<p class="empty">Nothing queued up in the next few minors.</p>{{end}}

  <h2>Upgrade sequence</h2>
  {{if .Plan.Hops}}
  <div class="scroll">
  <table>
    <thead><tr><th>Hop</th><th>What stops being served</th><th>Objects hit</th><th>Addon floors</th></tr></thead>
    <tbody>
    {{range .Plan.Hops}}
      <tr>
        <td class="mono">{{.From}} &rarr; {{.To}}</td>
        <td>
          {{if .Removals}}
            {{range .Removals}}<div class="mono">{{.Rule.From}} {{.Rule.Kind}}</div>{{end}}
          {{else}}<span class="empty">nothing in this repository</span>{{end}}
        </td>
        <td>{{.Hits}}</td>
        <td>
          {{if .AddonFloors}}
            {{range $k, $v := .AddonFloors}}<div class="mono">{{$k}} &ge; {{$v}}</div>{{end}}
          {{else}}<span class="empty">-</span>{{end}}
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
  </div>
  {{else}}<p class="empty">Target version is not newer than the current version.</p>{{end}}

  {{if .Plan.Sequencing}}
  <h2>{{.Plan.ProviderName}} control plane and node group order</h2>
  <ol class="seq">{{range .Plan.Sequencing}}<li>{{.}}</li>{{end}}</ol>
  {{end}}

  {{if .Plan.Verdict.OutOfScope}}
  <h2>Out of scope</h2>
  <ul>{{range .Plan.Verdict.OutOfScope}}<li>{{.}}</li>{{end}}</ul>
  {{end}}

  {{if .Skipped}}
  <h2>Skipped inputs</h2>
  <p class="sub">Not scanned, and therefore not covered by the verdict above.</p>
  <ul>{{range .Skipped}}<li class="mono">{{.}}</li>{{end}}</ul>
  {{end}}

  <footer>
    Generated from manifests on disk. A live cluster may run objects that are not in this repository;
    this report covers what was scanned and nothing else.
  </footer>
</main>
</body>
</html>

{{define "finding"}}
<div class="finding">
  <div class="head">
    <span class="title">{{.Title}}</span>
    {{if .Autofix}}<span class="tag auto">auto-fixable</span>{{end}}
    {{if .Owner}}<span class="tag owner">{{.Owner.Kind}}{{if .Owner.Name}} {{.Owner.Name}}{{end}}</span>{{end}}
    <span class="tag">{{.Category}}</span>
  </div>
  <div class="where mono">{{.Resource.File}}:{{.Resource.Line}} &middot; {{.Resource.Kind}} {{if .Resource.Namespace}}{{.Resource.Namespace}}/{{end}}{{.Resource.Name}}</div>
  <p>{{.Message}}</p>
  {{if .Owner}}<p class="where">Detected via {{.Owner.Reason}}.</p>{{end}}
  <p class="fix">{{.Remediation}}{{if .Docs}} <a href="{{.Docs}}">Reference</a>{{end}}</p>
</div>
{{end}}
